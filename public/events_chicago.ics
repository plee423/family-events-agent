ACTION:DISPLAY
DESCRIPTION:Tomorrow: Meet a Scientist: Neotropical Bats
TRIGGER:-P1D
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:In 2 hours: Meet a Scientist: Neotropical Bats
TRIGGER:-PT2H
END:VALARM
END:VEVENT
